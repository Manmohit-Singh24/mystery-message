{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": [".next/**", "dist/**"]
    },

    "start": { "dependsOn": ["^build", "build"] },
    "test": { "dependsOn": ["^build", "build"] },

    "typecheck": { "dependsOn": ["^build"] }
  }
}
