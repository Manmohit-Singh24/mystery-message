{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },

    "start": { "dependsOn": ["^build", "build"] },
    "test": { "dependsOn": ["^build", "build"] },

    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "lint:fix": {},
    "format": { "cache": false },
    "format:check": {}
  }
}
